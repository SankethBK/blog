    {
      "id": "rHI3l8g7zUGHKHtI7Echj",
      "type": "text",
      "x": -11193.53351277483,
      "y": 4314.311079795024,
      "width": 2258.63330078125,
      "height": 2295,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b19",
      "roundness": null,
      "seed": 1649835729,
      "version": 274,
      "versionNonce": 1430835857,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "DCZQv6cKCSByb787jldb2",
