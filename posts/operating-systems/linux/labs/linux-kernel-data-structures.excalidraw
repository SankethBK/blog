      "updated": 1784475430579,
      "link": null,
      "locked": false,
      "text": "file {\n        const struct path f_path\n        \n        loff_t f_pos (The file offset — this is literally \"where am I in the file right now\" for *this* open instance.)\n        \n        const struct file_operations * f_op (Pointer to Operations Table)\n        struct address_space *f_mapping. (Page cache mapping — usually just mirrors the inode's `i_mapping`)\n        struct inode  *f_inode  (Pointer to inode struct for this file)\n\n        unsigned int  f_flags  (Flags from `open()` — `O_APPEND`, `O_NONBLOCK`, etc.)\n        fmode_t  f_mode  (Read/write access mode for this open )\n}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "file {\n        const struct path f_path\n        \n        loff_t f_pos (The file offset — this is literally \"where am I in the file right now\" for *this* open instance.)\n        \n        const struct file_operations * f_op (Pointer to Operations Table)\n        struct address_space *f_mapping. (Page cache mapping — usually just mirrors the inode's `i_mapping`)\n        struct inode  *f_inode  (Pointer to inode struct for this file)\n\n        unsigned int  f_flags  (Flags from `open()` — `O_APPEND`, `O_NONBLOCK`, etc.)\n        fmode_t  f_mode  (Read/write access mode for this open )\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
