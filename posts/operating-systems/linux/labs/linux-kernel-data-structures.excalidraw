      "index": "b0F",
      "roundness": null,
      "seed": 948118577,
      "version": 149,
      "versionNonce": 2047095793,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "FwF5Hm7hSNjqT54O5HSG-",
          "type": "arrow"
        }
      ],
      "updated": 1784443657397,
      "link": null,
      "locked": false,
      "text": "fd\n\nWhen the process starts, this fd pointer points right back into the small, embedded fd_array[] \ninside the files_struct. If the process expands beyond that default size, fd is redirected to point \nto a brand new, massive array allocated on the heap.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fd\n\nWhen the process starts, this fd pointer points right back into the small, embedded fd_array[] \ninside the files_struct. If the process expands beyond that default size, fd is redirected to point \nto a brand new, massive array allocated on the heap.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
