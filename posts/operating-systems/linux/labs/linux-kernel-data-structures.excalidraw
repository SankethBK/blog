    {
      "id": "2BzRHy5loEop3UU7XqF7a",
      "type": "text",
      "x": -7596.472777585349,
      "y": 197.6310501536788,
      "width": 1650.86669921875,
      "height": 1575,
      "angle": 0,
      "strokeColor": "#2f9e44",
