      "link": null,
      "locked": false,
      "text": "    mm_struct {\n        vm_area_struct * mmap (pointer to the head of VMA linked list)\n        maple_tree mm_mt (maple tree of VMA's)\n        int map_count (number of VMAs)\n\n        struct percpu_counter rss_stat[NR_MM_COUNTERS] (per-cpu array which tracks file backed pages + anonymous pages + disk backed pages)\n        unsigned long hiwater_rss  (Maximum number of page frames ever owned by the process)\n        unsigned long hiwater_vm;  (Maximum number of pages ever commited to the memory regions of the process, not necessarily allocated)\n        \n        unsigned long total_vm  (Size of the process address space (number of pages))\n        unsigned long locked_vm;  (Number of “locked” pages that cannot be swapped out - Pages that have PG_mlocked set, triggered by userspace calling mlock() to prevent swapping)\n        atomic64_t    pinned_vm;   ( /* Refcount permanently increased */\n        unsigned long data_vm;           /* VM_WRITE & ~VM_SHARED & ~VM_STACK */\n        unsigned long exec_vm;  (Number of pages in executable memory mappings)         /* VM_EXEC & ~VM_WRITE & ~VM_STACK */\n        unsigned long stack_vm;     (Number of pages in the User Mode stack)      /* VM_STACK */\n        \n\n\n        pgd_t * pgd (Pointer to the Page Global Directory - loaded into CR3)\n\n\n        atomic_t mm_users (The number of users including userspace)\n        int mm_count (The number of references to &struct, considers userspace count as 1, primarily used by kernel for pinning mm_struct)\n\n        unsigned long start_code (Initial address of executable code)\n        unsigned long end_code (Final address of executable code)\n        unsigned long start_data (Initial address of initialized data)\n        unsigned long end_data (Final address of initialized data)\n        unsigned long start_brk (Initial address of the heap)\n        unsigned long brk (Current final address of the heap)\n        unsigned long start_stack (Initial address of User Mode stack)\n        unsigned long arg_start (Initial address of command-line arguments)\n        unsigned long arg_end (Final address of command-line arguments) \n        unsigned long env_start (Initial address of environment variables)\n        unsigned long env_end.  (Final address of environment variables)\n\n\n     }\n        ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    mm_struct {\n        vm_area_struct * mmap (pointer to the head of VMA linked list)\n        maple_tree mm_mt (maple tree of VMA's)\n        int map_count (number of VMAs)\n\n        struct percpu_counter rss_stat[NR_MM_COUNTERS] (per-cpu array which tracks file backed pages + anonymous pages + disk backed pages)\n        unsigned long hiwater_rss  (Maximum number of page frames ever owned by the process)\n        unsigned long hiwater_vm;  (Maximum number of pages ever commited to the memory regions of the process, not necessarily allocated)\n        \n        unsigned long total_vm  (Size of the process address space (number of pages))\n        unsigned long locked_vm;  (Number of “locked” pages that cannot be swapped out - Pages that have PG_mlocked set, triggered by userspace calling mlock() to prevent swapping)\n        atomic64_t    pinned_vm;   ( /* Refcount permanently increased */\n        unsigned long data_vm;           /* VM_WRITE & ~VM_SHARED & ~VM_STACK */\n        unsigned long exec_vm;  (Number of pages in executable memory mappings)         /* VM_EXEC & ~VM_WRITE & ~VM_STACK */\n        unsigned long stack_vm;     (Number of pages in the User Mode stack)      /* VM_STACK */\n        \n\n\n        pgd_t * pgd (Pointer to the Page Global Directory - loaded into CR3)\n\n\n        atomic_t mm_users (The number of users including userspace)\n        int mm_count (The number of references to &struct, considers userspace count as 1, primarily used by kernel for pinning mm_struct)\n\n        unsigned long start_code (Initial address of executable code)\n        unsigned long end_code (Final address of executable code)\n        unsigned long start_data (Initial address of initialized data)\n        unsigned long end_data (Final address of initialized data)\n        unsigned long start_brk (Initial address of the heap)\n        unsigned long brk (Current final address of the heap)\n        unsigned long start_stack (Initial address of User Mode stack)\n        unsigned long arg_start (Initial address of command-line arguments)\n        unsigned long arg_end (Final address of command-line arguments) \n        unsigned long env_start (Initial address of environment variables)\n        unsigned long env_end.  (Final address of environment variables)\n\n\n     }\n        ",
      "autoResize": true,
