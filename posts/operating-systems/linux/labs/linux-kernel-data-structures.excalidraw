      "index": "b0A",
      "roundness": null,
      "seed": 1554694111,
      "version": 106,
      "versionNonce": 939802801,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "RfsLJRlnwCNs5prBtxB8O",
          "type": "arrow"
