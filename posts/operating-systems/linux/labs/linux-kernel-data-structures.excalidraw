      "updated": 1784447213205,
      "link": null,
      "locked": false,
      "text": "fdtable {\n    unsigned int max_fds (The absolute maximum capacity of the current arrays the kernel triggers a table resize if fds go beyond this.)\n    unsigned long *open_fds  (These are pointers to the active tracking bitmaps.)\n    \n    struct file __rcu **fd (This is a pointer-to-pointers. It is an array where every slot contains a pointer to a struct file)\n\n    struct rcu_head rcu\n}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fdtable {\n    unsigned int max_fds (The absolute maximum capacity of the current arrays the kernel triggers a table resize if fds go beyond this.)\n    unsigned long *open_fds  (These are pointers to the active tracking bitmaps.)\n    \n    struct file __rcu **fd (This is a pointer-to-pointers. It is an array where every slot contains a pointer to a struct file)\n\n    struct rcu_head rcu\n}",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ZBE5m6b8SPyjHbXm-xLT2",
      "type": "text",
      "x": -7657.331823464819,
      "y": -901.7409101558551,
      "width": 1758.5,
      "height": 225,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
