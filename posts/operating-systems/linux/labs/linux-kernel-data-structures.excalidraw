    {
      "id": "ZsY5EFggzk63axHH1kOl1",
      "type": "text",
      "x": -8363.729760446557,
      "y": -1707.0773401811289,
      "width": 2874.166748046875,
      "height": 315,
      "angle": 0,
      "strokeColor": "#2f9e44",
