    {
      "id": "pWlvZuUZ_AiEJkf0fRUE9",
      "type": "text",
      "x": 3082.6013684956783,
      "y": -2598.4280602945414,
      "width": 4743.5,
      "height": 1350,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
